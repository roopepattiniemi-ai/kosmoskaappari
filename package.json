{
  "name": "kosmoskaappari",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test src/shared/*.test.ts src/server/game/*.test.ts src/server/multiplayer.test.ts"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.10",
    "colyseus": "^0.18.12",
    "express": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "concurrently": "^9.1.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
